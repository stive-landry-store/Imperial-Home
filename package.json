{
  "name": "imperial-home",
  "private": true,
  "version": "1.0.0",
  "description": "Imperial Home \u2014 furnished apartments and car rental in Douala. App by stive landry store (NYAMI TCHOUPE STIVE LANDRY).",
  "author": {
    "name": "stive landry store",
    "url": "https://github.com/stive-landry-store"
  },
  "contributors": [
    {
      "name": "NYAMI TCHOUPE STIVE LANDRY (stive landry store)"
    }
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "setup": "node scripts/setup-project.mjs",
    "start": "vite --host",
    "db:check": "node scripts/check-connection.mjs",
    "db:link": "npx supabase link",
    "db:push": "npx supabase db push",
    "functions:deploy": "npx supabase functions deploy",
    "e2e": "playwright test --trace off",
    "db:types": "npx supabase gen types typescript --linked --schema public > src/types/supabase.gen.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/react": "10.78.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.7",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
