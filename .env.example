# Imperial Home — environment variables
# Conçu par stive landry store (NYAMI TCHOUPE STIVE LANDRY)

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# JWT anon key from Supabase → Project Settings → API (used by the React app)
VITE_SUPABASE_ANON_KEY=your-anon-key
# Public site address (custom domain once it is connected, e.g. https://imperialhome.cm)
VITE_SITE_URL=https://imperial-home.vercel.app
# Used in auth e-mail links (must match Supabase Auth → URL Configuration)
VITE_APP_URL=http://localhost:5173

# Optional — Cloudflare Turnstile captcha on sign-up (public site key)
VITE_TURNSTILE_SITE_KEY=
# Optional — Sentry error tracking (public DSN)
VITE_SENTRY_DSN=

# Vercel functions (server only)
# SITE_URL=https://imperial-home.vercel.app
# SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function secrets (set with `npx supabase secrets set`, never in the Vite app)
# SITE_URL=https://imperial-home.vercel.app
# ALLOWED_ORIGINS=https://imperial-home.vercel.app,https://imperialhome.cm
# TURNSTILE_SECRET_KEY=
# ANTHROPIC_API_KEY=            # reception assistant (Claude)
# ANTHROPIC_MODEL=claude-opus-5-5
# RESEND_API_KEY=               # transactional e-mail
# EMAIL_FROM=Imperial Home <reservations@your-domain>
# WHATSAPP_TOKEN=               # WhatsApp Business Cloud API
# WHATSAPP_PHONE_NUMBER_ID=
# PAYMENTS_WEBHOOK_SECRET=
