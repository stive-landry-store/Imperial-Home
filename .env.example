VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# JWT anon key from Supabase → Project Settings → API (used by the React app)
VITE_SUPABASE_ANON_KEY=your-anon-key
# Used in password-reset e-mail links (must match Supabase Auth → URL Configuration)
VITE_APP_URL=http://localhost:5173

# Optional — newer publishable key (CLI / dashboard); the Vite app uses VITE_SUPABASE_ANON_KEY
# SUPABASE_PUBLISHABLE_KEY=

# Edge Function secrets (set in Supabase dashboard, not in the Vite app)
# SUPABASE_SERVICE_ROLE_KEY=
# PAYMENTS_WEBHOOK_SECRET=
# OPENAI_API_KEY=
